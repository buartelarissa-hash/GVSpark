# Banco de dados PostgreSQL
DATABASE_URL="postgresql://gvspark:gvspark@localhost:5432/gvspark?schema=public"

# Nome do cookie e duração da sessão (horas)
SESSION_COOKIE_NAME="gvspark_session"
SESSION_TTL_HOURS="12"

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Armazenamento de arquivos: "local" (desenvolvimento) ou "s3" (produção)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Tamanho máximo de vídeo, em MB (padrão 1024)
# MAX_VIDEO_MB="1024"

# S3 compatível (Cloudflare R2, AWS S3, Supabase Storage, MinIO). Bucket PRIVADO.
# Exemplo Cloudflare R2:
# S3_ENDPOINT="https://<ID-DA-CONTA>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="gvspark-arquivos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"   # "true" para MinIO
