# Banco de dados PostgreSQL
DATABASE_URL="postgresql://gvspark:gvspark@localhost:5432/gvspark?schema=public"

# Nome do cookie e duração da sessão (horas)
SESSION_COOKIE_NAME="gvspark_session"
SESSION_TTL_HOURS="12"

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Armazenamento de arquivos (Fase 3): "local" ou "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
